{
  "name": "@school/backend",
  "version": "0.1.0",
  "private": true,
  "description": "School Management Platform backend: Node.js + Express 5 modular monolith (Clean Architecture, Drizzle ORM, PostgreSQL RLS)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.http.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main.worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.http.js",
    "start:worker": "node --enable-source-maps dist/main.worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "db:migrate": "bash ../db/tools/migrate.sh",
    "trn:simulate": "tsx scripts/simulate-bus.ts",
    "db:test-rebuild": "DB=school_platform_test bash ../db/tools/rebuild-and-test.sh",
    "openapi": "tsx --env-file-if-exists=.env scripts/export-openapi.ts",
    "db:schema": "tsx --env-file-if-exists=.env scripts/gen-db-schema.ts",
    "db:studio": "drizzle-kit studio",
    "keys:dev": "tsx scripts/dev-keys.ts",
    "user:create": "tsx --env-file-if-exists=.env scripts/create-user.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@node-rs/argon2": "^2.0.2",
    "@prometheus-io/client": "^0.16.1",
    "awilix": "^13.0.5",
    "bullmq": "^6.4.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "nodemailer": "^7.0.13",
    "otplib": "^13.5.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "rate-limiter-flexible": "^7.1.0",
    "swagger-ui-dist": "^5.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-dist": "^3.30.6",
    "dependency-cruiser": "^16.10.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.0.5"
  }
}
