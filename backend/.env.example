# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Runtime roles (see db/migrations/0000_bootstrap.sql). Through PgBouncer in production.
DATABASE_URL=postgres://sms_app:change-me@localhost:5432/school_platform_dev
DATABASE_REPLICA_URL=
DATABASE_WORKER_URL=postgres://sms_worker:change-me@localhost:5432/school_platform_dev
# Only for `npm run db:schema` (introspection) and test fixtures
DATABASE_OWNER_URL=postgres://sms_owner:change-me@localhost:5432/school_platform_dev
DB_POOL_MAX=20

# Optional in development: without Redis the app uses in-memory cache/rate limits and runs jobs inline.
REDIS_URL=redis://localhost:6379/0

# Tenancy: the organisation served by this deployment (core.organisation.code)
ORG_CODE=LIS

# Auth: Ed25519 keys (PEM, \n escaped). Generate: npm run keys:dev (see README)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
JWT_KID=dev-1
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS_WEB=30
REFRESH_TOKEN_TTL_DAYS_APP=90

# Field encryption (AES-256-GCM, base64 32 bytes) and blind index key (base64 32 bytes)
FIELD_KEY_V1=
BLIND_INDEX_KEY=

# Object storage (S3 / MinIO)
# s3 (MinIO / AWS) or local (disk under LOCAL_STORAGE_DIR, dev only). Default: local unless S3_ENDPOINT is set.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=var/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_PRIVATE=school-private
S3_BUCKET_PUBLIC=school-public
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# Integrations (console adapters in development)
SMS_PROVIDER=console
METRICS_TOKEN=dev-metrics-token
# Swagger UI at /api/docs (default: on outside production)
SWAGGER_ENABLED=true

# Public admission forms: Cloudflare Turnstile captcha (both set = on). FORM_TOKEN_SECRET: base64 key for form tokens
# (default: derived from BLIND_INDEX_KEY).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# FORM_TOKEN_SECRET=
